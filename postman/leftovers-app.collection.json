{
  "info": {
    "name": "NestJS Leftovers API",
    "description": "Postman collection for Leftovers NestJS application",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Root - check list of users",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/",
          "host": ["{{baseUrl}}"],
          "path": [""]
        },
        "description": "Returns a list of users"
      }
    },
    {
      "name": "Health check",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/health",
          "host": ["{{baseUrl}}"],
          "path": ["health"]
        },
        "description": "Checks if the server is running."
      }
    },
    {
      "name": "Auth signup",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\"email\": \"{{email}}\", \"password\": \"{{password}}\", \"name\": \"{{name}}\"}"
        },
        "url": {
          "raw": "{{baseUrl}}/auth/signup",
          "host": ["{{baseUrl}}"],
          "path": ["auth", "signup"]
        }
      },
      "description": "Creates new user account."
    },
    {
      "name": "Auth login",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\"email\": \"{{email}}\", \"password\": \"{{password}}\"}"
        },
        "url": {
          "raw": "{{baseUrl}}/auth/login",
          "host": ["{{baseUrl}}"],
          "path": ["auth", "login"]
        }
      },
      "description": "Logs in a user and returns a JWT."
    },
    {
      "name": "Auth register (initial setup)",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\"email\": \"{{email}}\", \"password\": \"{{password}}\", \"name\": \"{{name}}\"}"
        },
        "url": {
          "raw": "{{baseUrl}}/auth/register",
          "host": ["{{baseUrl}}"],
          "path": ["auth", "register"]
        }
      },
      "description": "Finishes the registration flow. User is being created."
    },
    {
      "name": "Auth register confirmation - user creation",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\"email\": \"{{email}}\", \"token\": \"{{token}}\"}"
        },
        "url": {
          "raw": "{{baseUrl}}/auth/confirm-registration",
          "host": ["{{baseUrl}}"],
          "path": ["auth", "confirm-registration"]
        }
      },
      "description": "Confirms user registration with email and token. Creates user and removes the registration request."
    },
    {
      "name": "Recipes - get all (filtered + search)",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}",
            "type": "text",
            "disabled": true
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/recipes?details=true&category=italian&rating=4&title=pasta",
          "host": ["{{baseUrl}}"],
          "path": ["recipes"],
          "query": [
            { "key": "details", "value": "true" },
            { "key": "category", "value": "italian" },
            { "key": "rating", "value": "4" },
            { "key": "title", "value": "pasta" }
          ]
        },
        "description": "Fetch recipes with optional filters, search and detailed output. Supports category, rating, date range and text search fields"
      }
    },
    {
      "name": "Recipes - get all - authenticated",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/recipes?details=true&category=italian&rating=4&title=pasta",
          "host": ["{{baseUrl}}"],
          "path": ["recipes"],
          "query": [{ "key": "details", "value": "false" }]
        },
        "description": "Fetch recipes with as an authenticated user"
      }
    },
    {
      "name": "Files - create presigned URL",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"fileName\": \"img.jpeg\",\"fileType\":\"image/png\",\"folder\":\"{{imageUploadFolder}}\"}"
        },
        "url": {
          "raw": "{{baseUrl}}/files/presigned-url",
          "host": ["{{baseUrl}}"],
          "path": ["files", "presigned-url"]
        }
      },
      "description": "Generates a presigned S3 upload URL for an image"
    },
    {
      "name": "File - upload to S3",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "image/png"
          }
        ],
        "body": {
          "mode": "binary",
          "binary": {}
        },
        "url": {
          "raw": "{{presignedUrl}}",
          "host": [],
          "fullUrl": "{{presignedUrl}}"
        }
      },
      "description": "Uploads the image directly to S3"
    },
    {
      "name": "Create new recipe",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\"title\": \"Pizza\",\"description\": \"Tasty pizza\",\"category\": \"ITALIAN\",\"prep_time\": 30,\"servings\": 2,\"ingredients\": [\"flour\", \"water\"],\"steps\": [\"mix\", \"bake\"]}"
        },
        "url": {
          "raw": "{{baseUrl}}/recipes",
          "host": ["{{baseUrl}}"],
          "path": ["recipes"]
        }
      },
      "description": "Creates a new recipe for an authenticated user"
    },
    {
      "name": "Recipes - get by ID (public or private owned)",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}",
            "type": "text",
            "disabled": true
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/recipes/1",
          "host": ["{{baseUrl}}"],
          "path": ["recipes", "1"]
        },
        "description": "Fetch a single recipe by ID. Returns public recipes for all users. Private recipes are available only to their owners, when logged in."
      }
    }
  ],
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000",
      "type": "string"
    },
    {
      "key": "email",
      "value": "test@example.com",
      "type": "string"
    },
    {
      "key": "password",
      "value": "password",
      "type": "string"
    },
    {
      "key": "name",
      "value": "John Doe",
      "type": "string"
    },
    {
      "key": "token",
      "value": "token-from-confirmation-email",
      "type": "string"
    },
    {
      "key": "imageUploadFolder",
      "value": "images",
      "type": "string"
    },
    {
      "key": "presignedUrl",
      "value": "presigned-url",
      "type": "string"
    }
  ]
}
