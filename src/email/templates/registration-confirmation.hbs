<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Confirm your email</title>
</head>

<body
  style="
    margin:0;
    padding:0;
    background-color:#fafafa;
    font-family:'Poppins', Arial, Helvetica, sans-serif;
  "
>

<table width="100%" cellpadding="0" cellspacing="0" role="presentation">
  <tr>
    <td align="center" style="padding:40px 20px;">

      <table
        width="600"
        cellpadding="0"
        cellspacing="0"
        role="presentation"
        style="
          background:#ffffff;
          border-radius:8px;
          overflow:hidden;
        "
      >

        <tr>
          <td style="padding:30px 40px;">
            <table cellpadding="0" cellspacing="0" role="presentation">
              <tr>
                <td style="padding-right:8px;">
                  <img
                    src="{{frontendUrl}}/assets/logo.svg"
                    alt="Leftovers"
                    width="32"
                    height="32"
                    style="display:block;border:0;"
                  />
                </td>

                <td
                  style="
                    color:#60ad5e;
                    font-size:34px;
                    font-weight:300;
                    font-family:'Poppins', Arial, sans-serif;
                  "
                >
                  Leftovers
                </td>
              </tr>
            </table>
          </td>
        </tr>

        <tr>
          <td style="padding:0 40px 40px;">

            <h1
              style="
                margin:0 0 20px;
                font-size:28px;
                font-weight:400;
                color:#222222;
              "
            >
              Welcome to Leftovers!
            </h1>

            <p
              style="
                margin:0 0 30px;
                color:#555555;
                font-size:14px;
                line-height:24px;
              "
            >
              To kickstart your journey with us and to ensure the security of
              your account, please complete the email verification process by
              pressing the button below.
            </p>

            <table cellpadding="0" cellspacing="0" role="presentation">
              <tr>
                <td
                  style="
                    background:#60ad5e;
                    border-radius:6px;
                  "
                >
                  <a
                    href="{{confirmationlink}}"
                    style="
                      display:inline-block;
                      padding:12px 24px;
                      color:#ffffff;
                      text-decoration:none;
                      font-size:14px;
                      font-weight:600;
                    "
                  >
                    Confirm your e-mail
                  </a>
                </td>
              </tr>
            </table>

          </td>
        </tr>

        <tr>
          <td style="padding:0 40px;">
            <hr style="border:none;border-top:1px solid #dddddd;">
          </td>
        </tr>

        <tr>
          <td style="padding:25px 40px 10px;">

            <p
              style="
                margin:0;
                color:#666666;
                font-size:14px;
                line-height:22px;
              "
            >
              If you didn't create an account, feel free to ignore this email.
            </p>

          </td>
        </tr>

        <tr>
          <td style="padding:10px 40px 25px;">

            <p
              style="
                margin:0 0 8px;
                color:#666666;
                font-size:14px;
              "
            >
              All the best,
            </p>

            <strong
              style="
                font-size:14px;
                color:#222222;
              "
            >
              Leftovers Team
            </strong>

          </td>
        </tr>

        <tr>
          <td style="padding:0 40px 30px;">
            <table cellpadding="0" cellspacing="0" role="presentation">
              <tr>

                <td style="padding-right:12px;">
                  <a
                    href="https://instagram.com"
                    style="text-decoration:none;"
                  >
                    <img
                      src="{{frontendUrl}}/assets/instagram.svg"
                      alt="Instagram"
                      width="32"
                      height="32"
                      style="display:block;border:0;"
                    />
                  </a>
                </td>

                <td>
                  <a
                    href="https://facebook.com"
                    style="text-decoration:none;"
                  >
                    <img
                      src="{{frontendUrl}}/assets/facebook.svg"
                      alt="Facebook"
                      width="32"
                      height="32"
                      style="display:block;border:0;"
                    />
                  </a>
                </td>

              </tr>
            </table>
          </td>
        </tr>

        <tr>
          <td style="padding:0 40px;">
            <hr style="border:none;border-top:1px solid #dddddd;">
          </td>
        </tr>

        <tr>
          <td align="left" style="padding:30px 40px;">

            <img
              src="{{frontendUrl}}/assets/logo.svg"
              alt="Leftovers"
              width="32"
              height="32"
              style="
                display:block;
                border:0;
                margin-bottom:20px;
              "
            />

            <table
              cellpadding="0"
              cellspacing="0"
              role="presentation"
              style="margin-bottom:20px;"
            >
              <tr>

                <td
                  valign="middle"
                  style="
                    padding-right:8px;
                    line-height:18px;
                  "
                >
                  <img
                    src="{{frontendUrl}}/assets/email.svg"
                    alt="Email"
                    width="32"
                    height="32"
                    style="
                      display:block;
                      border:0; 
                      filter: brightness(0) saturate(100%) opacity(0.6);
                    "
                  />
                </td>

                <td
                  valign="middle"
                  style="
                    line-height:18px;
                  "
                >
                  <a
                    href="mailto:contact@leftovers.com"
                    style="
                      color:#666666;
                      text-decoration:underline;
                      font-size:14px;
                      font-family:'Poppins', Arial, sans-serif;
                    "
                  >
                    contact@leftovers.com
                  </a>
                </td>

              </tr>
            </table>

            <p style="margin:0 0 16px;">
              <a
                href="{{frontendUrl}}/privacy"
                style="
                  color:#666666;
                  text-decoration:underline;
                  font-size:14px;
                "
              >
                Privacy Policy
              </a>
            </p>

            <p style="margin:0;">
              <a
                href="{{frontendUrl}}/terms"
                style="
                  color:#666666;
                  text-decoration:underline;
                  font-size:14px;
                "
              >
                Terms &amp; Conditions
              </a>
            </p>

          </td>
        </tr>

      </table>

    </td>
  </tr>
</table>

</body>
</html>
